{
  // AsciiWorldEngine — the lift, cut as a short film in ShowReel.
  //
  // The sequence the captain called: open on a bare terminal, the run command
  // types itself out, BOOM the city comes up, walk the avenue and look up the
  // towers, then into the lift and up over the rooftops. Two clips, both real
  // captures of the running engine (street-capture.mp4, lift-ride-capture.mp4),
  // one procedural chiptune arranged to the cuts.
  //
  // 30.0s at 128 BPM = 16 bars of 1.875s. The music drops on the reveal cut at
  // 3.75s (2 bars). See lift-ride.assets.md alongside for how each asset was made.
  "width": 1280,
  "height": 720,
  "fps": 30,
  "title": "AsciiWorldEngine — the lift",
  "background": "#0a0c10",

  "audio": [
    {
      "asset": "lift-chiptune.wav",
      "at": 0.0,
      "from": 0.0,
      "fade_in": 0.25,
      "fade_out": 1.3,
      "gain": 0.85
    }
  ],

  // --- 1. THE TERMINAL — the command types itself out ------------------------
  "opening": {
    "duration": 3.75,
    "layers": [
      { "type": "solid", "colour": "#0a0c10", "from": 0.0, "z": 0 },
      // a slim window bar, so it reads as a terminal and not floating text
      { "type": "solid", "colour": "#161a22", "from": 0.0, "z": 1,
        "placement": { "fx": 0.0, "fy": 0.0, "fw": 1.0, "fh": 0.058 },
        "enter": { "kind": "fade", "duration": 0.4, "timing": { "kind": "eased", "easing": "out-cubic" } } },
      { "type": "text", "text": "●  ●  ●",
        "style": { "family": ["Noto Sans Mono", "DejaVu Sans Mono", "monospace"], "weight": 500,
          "italic": false, "size": 20.0, "tracking": 0.0, "line_height": 1.2, "fill": "#3b4250",
          "stroke": null, "shadow": null, "case": "as-written", "align": "left", "tabular": false },
        "from": 0.15, "z": 2, "placement": { "fx": 0.02, "fy": 0.012, "fw": 0.2, "fh": 0.05 },
        "enter": { "kind": "fade", "duration": 0.4, "timing": { "kind": "eased", "easing": "out-cubic" } } },
      { "type": "text", "text": "asciiworldengine — zsh",
        "style": { "family": ["Noto Sans Mono", "DejaVu Sans Mono", "monospace"], "weight": 500,
          "italic": false, "size": 20.0, "tracking": 0.0, "line_height": 1.2, "fill": "#6b7486",
          "stroke": null, "shadow": null, "case": "as-written", "align": "centre", "tabular": false },
        "from": 0.15, "z": 2, "placement": { "fx": 0.3, "fy": 0.012, "fw": 0.4, "fh": 0.05 },
        "enter": { "kind": "fade", "duration": 0.4, "timing": { "kind": "eased", "easing": "out-cubic" } } },
      // the prompt — already there, dim
      { "type": "text", "text": "~/AsciiWorldEngine $",
        "style": { "family": ["Noto Sans Mono", "DejaVu Sans Mono", "monospace"], "weight": 500,
          "italic": false, "size": 40.0, "tracking": 0.0, "line_height": 1.25, "fill": "#7d8798",
          "stroke": null, "shadow": null, "case": "as-written", "align": "left", "tabular": false },
        "from": 0.35, "z": 3, "placement": { "fx": 0.1, "fy": 0.42, "fw": 0.6, "fh": 0.1 },
        "enter": { "kind": "fade", "duration": 0.45, "timing": { "kind": "eased", "easing": "out-cubic" } } },
      // the command — types itself out, character by character
      { "type": "text", "text": "./play",
        "style": { "family": ["Noto Sans Mono", "DejaVu Sans Mono", "monospace"], "weight": 700,
          "italic": false, "size": 40.0, "tracking": 0.0, "line_height": 1.25, "fill": "#71e39b",
          "stroke": null, "shadow": null, "case": "as-written", "align": "left", "tabular": false },
        "from": 0.95, "z": 3, "placement": { "fx": 0.505, "fy": 0.42, "fw": 0.4, "fh": 0.1 },
        "enter": { "kind": "chars", "stagger": 0.11, "rise": 6.0, "duration": 0.28,
          "timing": { "kind": "eased", "easing": "out-cubic" } } },
      // a block cursor, arriving after the command is typed
      { "type": "solid", "colour": "#71e39b", "from": 1.85, "z": 3,
        "placement": { "fx": 0.63, "fy": 0.432, "fw": 0.018, "fh": 0.062 },
        "enter": { "kind": "fade", "duration": 0.12 } }
    ]
  },

  "then": [
    // --- 2. BOOM — the city comes up. A hard cut, on the beat. --------------
    {
      "transition": { "duration": 0.0, "presentation": { "kind": "cut" },
        "timing": { "kind": "eased", "easing": "linear" } },
      "scene": {
        "duration": 11.25,
        "layers": [
          { "type": "clip", "asset": "street-capture.mp4", "fit": "cover",
            "trim": [0.35, 11.25], "start": 0.0, "decode_fps": 30.0, "speed": 1.0,
            "mode": "hold", "max_width": 1280, "audio": { "muted": true }, "z": 0 },
          // one quiet identity plate, then gone — restraint
          { "type": "lower-third", "text": "AsciiWorldEngine",
            "detail": "a walkable city, generated from a seed, in your terminal",
            "from": 1.1, "duration": 3.4, "z": 2 }
        ]
      }
    },
    // --- 3. INTO THE LIFT — a cross-blur bridges look-up to the ride --------
    {
      "transition": { "duration": 0.6, "presentation": { "kind": "cross-blur", "radius": 26.0 },
        "timing": { "kind": "eased", "easing": "in-out-cubic" } },
      "scene": {
        "duration": 15.6,
        "layers": [
          { "type": "clip", "asset": "lift-ride-capture.mp4", "fit": "cover",
            "trim": [0.7, 21.1], "start": 0.0, "decode_fps": 30.0, "speed": 1.35,
            "mode": "hold", "max_width": 1280, "audio": { "muted": true }, "z": 0 },
          // a clean fade to black at the very end, so it lands rather than stops
          { "type": "solid", "colour": "#05070c", "from": 15.0, "z": 5,
            "placement": { "fx": 0.0, "fy": 0.0, "fw": 1.0, "fh": 1.0 },
            "enter": { "kind": "fade", "duration": 0.6, "timing": { "kind": "eased", "easing": "in-out-cubic" } } }
        ]
      }
    }
  ]
}
